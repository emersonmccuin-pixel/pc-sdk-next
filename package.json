{
  "name": "pc-sdk",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.13.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "spike": "pnpm --filter @pc-sdk/spike start",
    "spike:codex": "node apps/server/node_modules/tsx/dist/cli.mjs apps/server/scripts/codex-spike.ts",
    "smoke": "pnpm --filter @pc-sdk/server smoke",
    "smoke:codex": "node apps/server/node_modules/tsx/dist/cli.mjs apps/server/scripts/codex-live-smoke.ts",
    "backup": "node scripts/backup-data.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check:dead-imports": "node scripts/check-dead-imports.mjs",
    "check:process-boundaries": "node scripts/check-process-boundaries.mjs",
    "ci:check": "pnpm typecheck && pnpm test && pnpm check:dead-imports && pnpm check:process-boundaries"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "node-gyp": "12.3.0"
  }
}
